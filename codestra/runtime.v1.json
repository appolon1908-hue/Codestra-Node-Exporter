{
  "schemaVersion": "1.0",
  "component": "node-exporter",
  "role": "private-host-metrics-and-operational-evidence-authority",
  "canonicalHostname": "node.codestra.media",
  "exposure": "internal_private",
  "status": "CONFIG_PREPARED_NOT_DEPLOYED",
  "businessScope": ["platform"],
  "targetAttribution": [
    "codestra_business",
    "application",
    "service",
    "environment",
    "server",
    "region",
    "deployment"
  ],
  "nativeCollectors": [
    "boottime",
    "cpu",
    "cpufreq",
    "diskstats",
    "dmi",
    "entropy",
    "filefd",
    "filesystem",
    "hwmon",
    "loadavg",
    "mdadm",
    "meminfo",
    "netclass",
    "netdev",
    "netstat",
    "os",
    "pressure",
    "processes",
    "sockstat",
    "stat",
    "textfile",
    "thermal_zone",
    "time",
    "timex",
    "uname",
    "vmstat"
  ],
  "collectorBoundaries": {
    "disableDefaults": true,
    "systemdDbusCollector": false,
    "hostNetwork": false,
    "hostPidNamespace": false,
    "privilegedMode": false,
    "dockerSocket": false,
    "containerMetrics": false,
    "applicationMetrics": false,
    "textfileExecutesScripts": false
  },
  "textfileEvidence": {
    "directory": "/var/lib/node_exporter/textfile_collector",
    "atomicRenameRequired": true,
    "sampleTimestampsForbidden": true,
    "unboundedLabelsForbidden": true,
    "approvedDomains": [
      "backup",
      "restore_validation",
      "certificate_expiry",
      "deployment_version",
      "configuration_drift",
      "security_updates",
      "reboot_required",
      "disaster_recovery"
    ]
  },
  "transport": {
    "tls": true,
    "minimumVersion": "TLS13",
    "prometheusClientCertificateRequired": true,
    "basicAuthentication": false,
    "anonymousPlainHttp": false,
    "nativeHostPortPublished": false,
    "privatePort": 9100
  },
  "runtime": {
    "uid": 10001,
    "gid": 10001,
    "readOnlyRootFilesystem": true,
    "dropAllCapabilities": true,
    "noNewPrivileges": true,
    "hostMountsReadOnly": true,
    "hostRootMountRequiredForFilesystemStats": true,
    "immutableImageRequired": true,
    "resourceLimitsRequired": true
  },
  "authorityBoundaries": {
    "nodeExporterOwnsHostMetrics": true,
    "cadvisorOwnsContainerMetrics": true,
    "opentelemetryOwnsApplicationMetrics": true,
    "prometheusOwnsRecordingRulesSloAndAlerts": true,
    "blackboxOwnsExternalSyntheticChecks": true,
    "alloyOwnsHostAndServiceLogs": true,
    "businessMutation": false,
    "communicationsDelivery": false,
    "identityAuthority": false,
    "secretsAuthority": false,
    "financialOrTradingMutation": false
  },
  "activation": {
    "imageBuilt": false,
    "immutableDigestRecorded": false,
    "hostMountAllowlistReviewed": false,
    "nonRootHostReadAccessProven": false,
    "textfileDirectoryPrepared": false,
    "textfileProducerOwnershipProven": false,
    "atomicWriteTestPassed": false,
    "textfileCardinalityTestPassed": false,
    "backupEvidencePresent": false,
    "restoreValidationEvidencePresent": false,
    "certificateEvidencePresent": false,
    "deploymentEvidencePresent": false,
    "driftEvidencePresent": false,
    "serverCertificateIssued": false,
    "prometheusClientCaInstalled": false,
    "mtlsScrapePassed": false,
    "collectorCompatibilityPassed": false,
    "productionApproved": false,
    "deploymentEnabled": false
  }
}
