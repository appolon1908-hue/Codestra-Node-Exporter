# Non-secret Codestra Node Exporter runtime contract.
# Certificate and private-key values are external runtime secrets and never belong here.

CODESTRA_ENVIRONMENT=staging
CODESTRA_REGION=hetzner-eu
CODESTRA_SERVER=replace-with-canonical-server-name
CODESTRA_NODE_EXPORTER_DEPLOYMENT_ID=replace-with-immutable-release-id

# Complete immutable image references containing @sha256:...
GO_BUILDER_IMAGE=golang:REPLACE_WITH_PINNED_VERSION@sha256:REPLACE_WITH_REAL_DIGEST
NODE_EXPORTER_BASE_IMAGE=prom/node-exporter:REPLACE_WITH_PINNED_VERSION@sha256:REPLACE_WITH_REAL_DIGEST
CODESTRA_NODE_EXPORTER_IMAGE=ghcr.io/appolon1908-hue/codestra-node-exporter:REPLACE_WITH_RELEASE@sha256:REPLACE_WITH_REAL_DIGEST

# Only approved atomic *.prom files may exist in this directory.
NODE_EXPORTER_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector
CODESTRA_OBSERVABILITY_NETWORK=codestra-observability

# External secret object names only.
NODE_EXPORTER_SERVER_CERT_SECRET_NAME=node-exporter-server-cert
NODE_EXPORTER_SERVER_KEY_SECRET_NAME=node-exporter-server-key
PROMETHEUS_CLIENT_CA_SECRET_NAME=prometheus-client-ca
