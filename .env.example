# Runtime image is assembled as repository@sha256:digest. Repository values must
# not contain tags/digests; digest values must be exactly 64 lowercase hex characters.
NODE_EXPORTER_IMAGE_REPOSITORY=quay.io/prometheus/node-exporter
NODE_EXPORTER_IMAGE_DIGEST=

# Override per server: core=10.40.0.1, telephony=10.40.0.2, provider=10.40.0.4.
# The preflight rejects wildcard, loopback, public, link-local, and addresses outside
# the approved Codestra private network 10.40.0.0/24.
NODE_EXPORTER_LISTEN_IP=10.40.0.1
NODE_EXPORTER_PORT=9100
NODE_EXPORTER_TEXTFILE_DIRECTORY=/var/lib/node_exporter/textfile_collector
