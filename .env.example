# Pin a reviewed upstream image by digest. Tags and latest are forbidden.
NODE_EXPORTER_IMAGE=

# Override per server: core=10.40.0.1, telephony=10.40.0.2, provider=10.40.0.4.
NODE_EXPORTER_LISTEN_IP=10.40.0.1
NODE_EXPORTER_PORT=9100
NODE_EXPORTER_TEXTFILE_DIRECTORY=/var/lib/node_exporter/textfile_collector
