{
  "schema": "kyyow.platform-component.v1",
  "repository": "appolon1908-hue/Codestra-Node-Exporter",
  "component": "node-exporter",
  "authority": "host-metrics",
  "exposure": "private",
  "native_ports": [
    9100
  ],
  "inputs": [
    "host:/proc (read-only /host/proc)",
    "host:/sys (read-only /host/sys)",
    "host:/ (read-only /host/root with rslave propagation)",
    "operator:textfile-directory (read-only)"
  ],
  "outputs": [
    "prometheus:metrics (mTLS scrape on 9100)"
  ],
  "controls": [
    "host root is mounted read-only for filesystem and udev statistics; this is host filesystem access",
    "host PID and network namespaces remain disabled in codestra/deploy/compose.candidate.yaml",
    "textfile collector directory is operator-controlled",
    "Prometheus client certificate is required; Alloy collects logs separately"
  ],
  "identity": {
    "authority": "appolon1908-hue/Keycloak",
    "workload_identity_required": true,
    "anonymous_admin_access": false
  },
  "secrets": {
    "authority": "appolon1908-hue/Codestra-OpenBao",
    "secrets_in_git": false,
    "environment_plaintext_secrets": false
  },
  "operations": {
    "middleware_is_sole_odoo_writer": true,
    "grafana_read_only": true,
    "superset_read_only": true
  },
  "activation": {
    "source_contract_complete": true,
    "runtime_evidence_complete": false,
    "production_activation_authorized": false
  }
}
